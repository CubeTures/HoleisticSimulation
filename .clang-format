BasedOnStyle: Microsoft
BinPackArguments: false
BinPackParameters: false
AlignAfterOpenBracket: BlockIndent
AllowAllParametersOfDeclarationOnNextLine: false
ColumnLimit: 80
BreakBeforeBraces: Attach
IncludeBlocks: Regroup
IncludeCategories:
  # 1. C++/C standard library, e.g. <vector>, <cstdio>
  - Regex: "^<[a-z_]+>$"
    Priority: 1
    SortPriority: 1
  # 3. This project's own headers, addressed from src/ (e.g. "force/Force.hpp")
  - Regex: '^"(arenas|assets|colliders|forces|generators|graphics|structures)/'
    Priority: 3
    SortPriority: 3
  # 2. Everything else: third-party libraries (raylib, raylib_cpp, ...)
  - Regex: ".*"
    Priority: 2
    SortPriority: 2
